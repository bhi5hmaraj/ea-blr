// Sensemaker MVP Schema
// Incorporates ADR-001 (Manual Processing), ADR-002 (Manual Deduplication),
// ADR-003 (Retry Logic), ADR-004 (Kernel One-to-Many), ADR-005 (Clerk Auth)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE MODELS
// ============================================================================

model Listing {
  id                 String       @id @default(cuid())
  kind               ListingKind  @default(JOB)

  // Stable identity: normalized URL, or hash of (source + externalId)
  // Generated by kernel processor (ADR-004)
  canonicalKey       String       @unique

  // Convenience fields for list views (not authoritative)
  title              String?
  orgName            String?
  sourceUrl          String?

  // Current published version
  selectedRevisionId String?      @unique
  selectedRevision   Revision?    @relation("SelectedRevision", fields: [selectedRevisionId], references: [id])

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // One listing can have many revisions over time
  revisions          Revision[]   @relation("ListingRevisions")

  @@index([kind, createdAt])
  @@index([orgName])
}

model Observation {
  id                 String            @id @default(cuid())

  // Source tracking
  sourceType         ObservationSource
  sourceRef          String?           // URL, "dm:<id>", "email:<id>", etc.
  capturedAt         DateTime          @default(now())

  // Raw content
  rawFormat          RawFormat
  rawText            String?           @db.Text // Inline text/markdown/html
  rawBlobRef         String?           // Object storage key for PDF/image/large HTML
  rawMeta            Json?             // { filename, mime, sizeBytes, headers, etc. }

  // Deduplication support (ADR-002: manual for MVP, computed post-MVP)
  contentHash        String?           // sha256 of normalized content

  // Processing state (ADR-001: Manual Processing, ADR-003: Retry Logic)
  processingStatus   ProcessingStatus  @default(PENDING)
  processingAttempts Int               @default(0)
  lastError          String?           @db.Text
  processedAt        DateTime?

  // Audit trail (ADR-005: Clerk Auth)
  createdBy          String?           // Clerk user ID who created observation
  processedBy        String?           // Clerk user ID who triggered processing

  createdAt          DateTime          @default(now())

  // One observation can generate multiple revisions (ADR-004: One-to-Many)
  revisions          Revision[]

  @@index([processingStatus, createdAt])
  @@index([sourceType, capturedAt])
  @@index([contentHash])
  @@index([createdBy])
}

model Revision {
  id                String         @id @default(cuid())

  // Links to listing (many revisions per listing)
  listingId         String
  listing           Listing        @relation("ListingRevisions", fields: [listingId], references: [id], onDelete: Cascade)

  // Provenance: which observation created this revision
  observationId     String?
  observation       Observation?   @relation(fields: [observationId], references: [id], onDelete: SetNull)

  // Schema versioning for payload evolution
  schemaVersion     Int

  // Lifecycle state
  status            RevisionStatus @default(PENDING)

  // Structured data
  extracted         Json           // LLM extracted payload
  edited            Json?          // Optional human edits overlay
  resolved          Json?          // Merged view (computed on approval)

  notes             String?        @db.Text

  // Audit trail (ADR-005: Clerk Auth)
  approvedBy        String?        // Clerk user ID who approved
  approvedAt        DateTime?

  createdAt         DateTime       @default(now())

  // Reference from Listing.selectedRevision (one-to-one)
  selectedByListing Listing?       @relation("SelectedRevision")

  @@index([listingId, createdAt])
  @@index([observationId])
  @@index([status, createdAt])
  @@index([approvedBy])
}

// ============================================================================
// ENUMS
// ============================================================================

enum ListingKind {
  JOB
  NEWS
}

enum RevisionStatus {
  PENDING   // Awaiting human review
  APPROVED  // Human approved, may be selected
  REJECTED  // Human rejected, will not be selected
}

enum ObservationSource {
  MANUAL    // Pasted text, uploaded file
  SCRAPE    // Automated web scrape
  EMAIL     // Email ingestion
  API       // External API submission
}

enum RawFormat {
  TEXT      // Plain text
  MARKDOWN  // Markdown document
  HTML      // HTML page/snippet
  PDF       // PDF document (rawBlobRef required)
  IMAGE     // Screenshot/image (rawBlobRef required)
}

enum ProcessingStatus {
  PENDING   // Not yet processed
  DONE      // Successfully extracted revisions
  FAILED    // Failed after retries (ADR-003)
}
