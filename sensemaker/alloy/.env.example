# Grafana Cloud credentials for Alloy
# Get these from Grafana Cloud -> your stack -> Connection details

# Loki (logs) - from grafanacloud-babbleprune-logs data source
GRAFANA_CLOUD_LOGS_USER=your-loki-user-id

# Prometheus (metrics) - from grafanacloud-babbleprune-prom data source
GRAFANA_CLOUD_METRICS_USER=your-prometheus-user-id

# Tempo (traces) - from grafanacloud-babbleprune-traces data source
GRAFANA_CLOUD_TRACES_USER=your-tempo-user-id

# API Key with write permissions (generate from Grafana Cloud -> API Keys)
GRAFANA_CLOUD_API_KEY=your-api-key

# Optional
NODE_ENV=development
CLUSTER_NAME=local
