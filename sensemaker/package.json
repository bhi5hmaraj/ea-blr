{
  "name": "sensemaker",
  "version": "0.1.0",
  "description": "Impact listings ingestion + curation with provenance",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.x <=22.x"
  },
  "scripts": {
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch src/server/entry.ts",
    "dev:client": "vite",
    "build": "prisma generate && pnpm build:server && pnpm build:client",
    "build:server": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js --packages=external",
    "build:client": "vite build",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^1.1.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@grafana/faro-react": "^2.1.0",
    "@grafana/faro-web-sdk": "^2.1.0",
    "@mozilla/readability": "^0.5.0",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "@prisma/client": "^6.2.0",
    "@vercel/blob": "^0.27.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsdom": "^24.1.3",
    "openai": "^4.85.0",
    "pino": "^10.2.0",
    "pino-loki": "^3.0.0",
    "ra-data-simple-rest": "^5.9.0",
    "react": "^18.3.1",
    "react-admin": "^5.9.0",
    "react-dom": "^18.3.1",
    "react-router": "^6.28.0",
    "react-router-dom": "^6.28.0",
    "turndown": "^7.2.2",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^8.2.2",
    "esbuild": "^0.27.2",
    "eslint": "^9.18.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "vite": "^6.3.5"
  },
  "pnpm": {
    "overrides": {
      "react-router": "^6.28.0",
      "react-router-dom": "^6.28.0"
    }
  },
  "packageManager": "pnpm@10.23.0"
}
