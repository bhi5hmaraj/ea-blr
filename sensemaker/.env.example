# Database
DATABASE_URL="postgresql://user:password@localhost:5432/sensemaker?schema=public"

# Clerk Authentication (ADR-005)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# LLM Processing
# Option 1: Direct OpenAI API
OPENAI_API_KEY="sk-..."

# Option 2: LiteLLM proxy (takes precedence if both are set)
# LITELLM_API_KEY="sk-..."
# LITELLM_BASE_URL="https://your-litellm-proxy.com"

# LLM Settings
LLM_MODEL="gpt-4o-2024-08-06"
LLM_TIMEOUT_MS=30000

# Set to "mock" to use MockJobKernel without any API key (dev only)
# LLM_PROVIDER="mock"

# Vercel (optional for local dev)
CRON_SECRET="your-secret-for-cron-endpoints"

# Storage (for rawBlobRef)
# In development, defaults to "local" (files in /tmp/sensemaker/)
# In production, defaults to "vercel-blob"
STORAGE_PROVIDER="local"
# LOCAL_STORAGE_DIR="/tmp/sensemaker"

# Vercel Blob (for production)
# STORAGE_PROVIDER="vercel-blob"
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# API Configuration
API_BASE_URL="http://localhost:3000"

# =============================================================================
# OBSERVABILITY - Direct to Grafana Cloud (no local Alloy needed)
# =============================================================================

# Backend Logs (pino -> Loki)
# Get from: Grafana Cloud -> Connections -> Add new connection -> Alloy -> Generate token
# GRAFANA_CLOUD_TOKEN="glc_..."
# LOG_LEVEL="info"  # debug, info, warn, error

# Frontend Observability (Faro -> Grafana Cloud)
# Create app: Grafana Cloud -> Frontend -> Create new app -> Copy collector URL
# VITE_FARO_COLLECTOR_URL="https://faro-collector-prod-ap-south-1.grafana.net/collect/xxx"
# VITE_FARO_APP_NAME="sensemaker-admin"

# =============================================================================
# OPTIONAL: Grafana Alloy for production (unified collector)
# =============================================================================
# Run with: docker-compose -f docker-compose.alloy.yml up
# GRAFANA_CLOUD_LOGS_USER="<loki-user-id>"
# GRAFANA_CLOUD_METRICS_USER="<prometheus-user-id>"
# GRAFANA_CLOUD_TRACES_USER="<tempo-user-id>"
# GRAFANA_CLOUD_API_KEY="<api-key>"
